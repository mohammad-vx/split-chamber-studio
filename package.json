{
  "name": "split-chamber",
  "productName": "Split Chamber Studio",
  "version": "2.2.1",
  "description": "Split Chamber Studio: deterministic ball-simulation video factory (generate, check, review, export 1080x1920 60 fps).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit/sim.test.mjs tests/unit/engine.test.mjs tests/unit/pipeline.test.mjs tests/unit/packed.test.mjs tests/unit/machines.test.mjs tests/unit/phase1.test.mjs",
    "test:e2e": "playwright test",
    "bench": "electron . --bench",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir",
    "gate": "node tools/baseline.mjs verify baseline/v1/sim.json baseline/v1/sim-raw.node.json && node tools/goldens.mjs verify && electron . --gate",
    "gate:pixels": "node tools/pixelgate.mjs"
  },
  "build": {
    "appId": "local.splitchamber.app",
    "productName": "Split Chamber Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json",
      "build/icon.png",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SplitChamberStudio-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SplitChamberStudio-${version}-setup.exe"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "mediabunny": "^1.65.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
